{
  "manifest_version": 3,
  "name": "PyIDM Integration Module",
  "version": "1.0.0",
  "description": "Seamlessly intercepts downloads and sends links to PyIDM Download Manager.",
  "permissions": [
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:18888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PyIDM Integration"
  }
}

