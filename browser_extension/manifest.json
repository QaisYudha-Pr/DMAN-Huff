{
  "manifest_version": 3,
  "name": "PyIDM Integration Module",
  "version": "2.0.0",
  "description": "Seamlessly intercepts downloads and detects web video/audio for PyIDM Download Manager.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:18888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PyIDM Integration"
  }
}
